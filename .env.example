# O Nexo carrega .env da raiz. Ambiente tem precedência; nunca versionar credenciais.
# brapi: obtenha sua chave em https://brapi.dev/dashboard
BRAPI_TOKEN=

# BRAPI_API_KEY é um alias opcional; BRAPI_TOKEN não vazio tem prioridade.
BRAPI_BATCH_SIZE=1
BOLSAI_API_KEY=
NEXO_PROVIDER_TEST_MODE=true
NEXO_BRAPI_SOFT_DAILY_BUDGET=100
NEXO_BOLSAI_SOFT_DAILY_BUDGET=60
NEXO_YAHOO_SOFT_DAILY_BUDGET=500
NEXO_CVM_SOFT_DAILY_BUDGET=2

# Somente habilitar quando o plano tiver acesso confirmado:
NEXO_BRAPI_DIVIDENDS_ENABLED=false
NEXO_BOLSAI_ACTIONS_ENABLED=false
# NEXO Intelligence — preencha somente a chave para habilitar Gemini em modo auto.
# Projeto Google AI Studio: NEXO Intelligence (identificação, não autenticação).
GEMINI_API_KEY=
NEXO_AI_PROJECT_ID=gen-lang-client-0662974523
NEXO_AI_PROJECT_NUMBER=1029731024680
NEXO_AI_ENABLED=true
NEXO_AI_PROVIDER=auto
NEXO_AI_MODEL=gemini-3.5-flash-lite
NEXO_AI_EXTRACTION_MODEL=gemini-3.5-flash-lite
NEXO_AI_VIDEO_MODEL=gemini-3.5-flash-lite
NEXO_AI_RETRIEVAL_MODEL=gemini-3.5-flash-lite
NEXO_AI_MAX_INPUT_TOKENS=32000
NEXO_AI_MAX_OUTPUT_TOKENS=2048
NEXO_AI_DAILY_REQUEST_LIMIT=20
NEXO_AI_DAILY_TOKEN_LIMIT=200000
NEXO_AI_MAX_TOOL_CALLS=8
NEXO_AI_FILE_SEARCH_STORE=
YOUTUBE_API_KEY=
# Valores opcionais em USD por milhão, conforme seu modelo/plano vigente.
NEXO_AI_INPUT_USD_PER_MILLION=
NEXO_AI_OUTPUT_USD_PER_MILLION=
